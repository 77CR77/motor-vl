.DS_Store

# Видео технического состояния — 3.3 ГБ, в git такому объёму не место.
# Файлы лежат локально в media/<id>/video/ и раздаются сайтом; для публикации
# в сети их нужно класть в отдельное хранилище (S3/R2) или на видеохостинг.
# Обложки роликов (media/<id>/video/poster/) — другое дело: по 44 КБ, они в git идут,
# чтобы на опубликованном сайте плитки видео были с картинками.
media/**/video/*.mp4
media/**/video/*.avi

# Пароль и токен бота живут только на хостинге.
api/config.local.php
# Заявки клиентов — личные данные, в репозиторий им нельзя.
private/leads.json
