# Настройки с паролем и токеном не должны отдаваться браузером ни при каких
# обстоятельствах — например, если на сервере вдруг отключат обработку PHP.
<FilesMatch "^config.*\.php$">
    Require all denied
</FilesMatch>

# Общий модуль — не точка входа, обращаться к нему напрямую незачем.
<FilesMatch "^lib\.php$">
    Require all denied
</FilesMatch>
